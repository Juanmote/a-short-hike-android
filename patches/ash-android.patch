diff --git a/UnityProject/Assets/Scripts/Assembly-CSharp/Credits.cs b/UnityProject/Assets/Scripts/Assembly-CSharp/Credits.cs
index 702e237..44f5a9d 100644
--- a/UnityProject/Assets/Scripts/Assembly-CSharp/Credits.cs
+++ b/UnityProject/Assets/Scripts/Assembly-CSharp/Credits.cs
@@ -9,6 +9,54 @@ public class Credits : MonoBehaviour
 	private void Start()
 	{
 		timeline.stopped += OnStopped;
+		AddPortCredit();
+	}
+
+	// Port Android: debajo de "adam robinson-yu" aparece " - Ported by Juanmote - ".
+	// Es una copia del mismo texto colgada de él, así que sale y se va a la vez.
+	private void AddPortCredit()
+	{
+		try
+		{
+			foreach (TMPro.TMP_Text t in Object.FindObjectsOfType<TMPro.TMP_Text>(true))
+			{
+				if (t == null || t.text == null || t.text.Trim() != "adam robinson-yu")
+				{
+					continue;
+				}
+				GameObject copy = Object.Instantiate(t.gameObject, t.transform);
+				foreach (Transform child in copy.transform)
+				{
+					Object.Destroy(child.gameObject);
+				}
+				foreach (MonoBehaviour mb in copy.GetComponents<MonoBehaviour>())
+				{
+					if (!(mb is TMPro.TMP_Text))
+					{
+						Object.Destroy(mb);
+					}
+				}
+				copy.name = "PortedBy";
+				TMPro.TMP_Text txt = copy.GetComponent<TMPro.TMP_Text>();
+				txt.text = "- ported by juanmote -";
+				txt.fontSize = t.fontSize;
+				RectTransform rt = copy.transform as RectTransform;
+				rt.localScale = Vector3.one;
+				rt.localRotation = Quaternion.identity;
+				rt.anchorMin = new Vector2(0.5f, 0f);
+				rt.anchorMax = new Vector2(0.5f, 0f);
+				rt.pivot = new Vector2(0.5f, 1f);
+				rt.anchoredPosition = new Vector2(0f, -2f);
+				rt.sizeDelta = new Vector2(Mathf.Max(200f, (t.transform as RectTransform).rect.width * 2f), t.fontSize * 1.5f);
+				Debug.Log("[ASH] Créditos: añadido Ported by Juanmote");
+				return;
+			}
+			Debug.LogWarning("[ASH] Créditos: no se encontró el texto del autor");
+		}
+		catch (System.Exception e)
+		{
+			Debug.LogWarning("[ASH] Créditos: " + e.Message);
+		}
 	}
 
 	private void OnStopped(PlayableDirector obj)
